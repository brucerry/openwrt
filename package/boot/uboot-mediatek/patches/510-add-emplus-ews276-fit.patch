--- /dev/null
+++ b/arch/arm/dts/mt7986a-emplus-ews276-fit.dts
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/dts-v1/;
+#include "mt7986.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "Emplus EWS276-FIT";
+	compatible = "emplus,ews276-fit", "mediatek,mt7986";
+	chosen {
+		stdout-path = &uart0;
+		tick-timer = &timer0;
+	};
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x20000000>;
+	};
+};
+
+&uart0 {
+	mediatek,force-highspeed;
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+	mediatek,gmac-id = <1>;
+	mediatek,sgmiisys = <&sgmiisys1>;
+	phy-mode = "sgmii";
+	phy-handle = <&phy6>;
+	phy6: ethernet-phy@6 {
+		compatible = "ethernet-phy-id67c9.de10";
+		reg = <6>;
+		reset-gpios = <&pio 6 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <600>;
+		reset-deassert-us = <20000>;
+	};
+};
+
+&pio {
+	spi_flash_pins: spi-flash-pins {
+		mux {
+			function = "flash";
+			groups = "spi0", "spi0_wp_hold";
+		};
+	};
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi_flash_pins>;
+	status = "okay";
+	must_tx;
+	enhance_timing;
+	dma_ext;
+	ipm_design;
+	support_quad;
+	tick_dly = <1>;
+	sample_sel = <0>;
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+	};
+};
--- /dev/null
+++ b/defenvs/emplus_ews276-fit_env
@@ -0,0 +1,13 @@
+bootcmd=run boot_flash
+bootdelay=5
+baudrate=115200
+mtdids=nmbm0=nmbm0
+mtdparts=nmbm0:1024k(BL2),512k(u-boot-env),2048k(Factory)ro,2048k(FIP),112640k(ubi),112640k(ubi_1)ro,512k(ubootenv)ro,384k(cert)ro,640k(userconfig)ro,384k(crashdump)ro
+boot_flash=if ubi part ubi; then if ubi read ${loadaddr} fit; then bootm ${loadaddr}; fi; fi
+boot_recovery=if tftpboot ${loadaddr} ${recoveryfile}; then bootm ${loadaddr}; fi
+loadaddr=0x46000000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+recoveryfile=openwrt-mediatek-filogic-emplus_ews276-fit-initramfs-recovery.itb
+fipfile=openwrt-mediatek-filogic-emplus_ews276-fit-spim-nand-bl31-uboot.fip
+bl2file=openwrt-mediatek-filogic-emplus_ews276-fit-spim-nand-preloader.bin
