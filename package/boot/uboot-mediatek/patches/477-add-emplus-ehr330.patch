--- a/board/mediatek/mt7987/mt7987_rfb.c
+++ b/board/mediatek/mt7987/mt7987_rfb.c
@@ -92,2 +92,33 @@ int mtk_ft_system_setup(void *blob, struct bd_info *bd)
 	return 0;
 }
+#include <mtd.h>
+#include <linux/mtd/mtd.h>
+#include <nmbm/nmbm.h>
+#include <nmbm/nmbm-mtd.h>
+
+int board_nmbm_init(void)
+{
+#ifdef CONFIG_NMBM_MTD
+	struct mtd_info *lower, *upper;
+	int ret;
+
+	printf("\nInitializing NMBM ...\n");
+	mtd_probe_devices();
+
+	lower = get_mtd_device_nm("spi-nand0");
+	if (IS_ERR(lower) || !lower) {
+		printf("Lower MTD device 'spi-nand0' not found\n");
+		return 0;
+	}
+
+	ret = nmbm_attach_mtd(lower,
+			      NMBM_F_CREATE | NMBM_F_EMPTY_PAGE_ECC_OK,
+			      1, 128, &upper);
+	printf("\n");
+	if (ret)
+		return 0;
+
+	add_mtd_device(upper);
+#endif
+	return 0;
+}
