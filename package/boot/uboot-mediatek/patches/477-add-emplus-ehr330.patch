--- /dev/null
+++ b/defenvs/emplus_ehr330_env
@@ -0,0 +1,25 @@
+baudrate=115200
+bootargs=ubi.block=0,kernel root=/dev/fit0 rootwait
+bootcmd=ubi part ubi && ubi read ${loadaddr} kernel && bootm ${loadaddr}
+bootdelay=2
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+netmask=255.255.255.0
+loadaddr=0x48000000
+verifyaddr=0x4f000000
+recoveryfile=openwrt-mediatek-filogic-emplus_ehr330-signed-initramfs-recovery.itb
+bl2file=openwrt-mediatek-filogic-emplus_ehr330-signed-spim-nand-preloader.bin
+fipfile=openwrt-mediatek-filogic-emplus_ehr330-signed-spim-nand-bl31-uboot.fip
+kernelfile=openwrt-mediatek-filogic-emplus_ehr330-signed-squashfs-sysupgrade.itb
+boot_recovery=tftpboot ${loadaddr} ${recoveryfile} && bootm ${loadaddr}
+load_bl2=mw.b ${loadaddr} 0xff 0x100000 && tftpboot ${loadaddr} ${bl2file}
+load_fip=mw.b ${loadaddr} 0xff 0x200000 && tftpboot ${loadaddr} ${fipfile}
+load_kernel=tftpboot ${loadaddr} ${kernelfile}
+calc_write_size=setexpr write_size ${filesize} + 0x7ff && setexpr write_size ${write_size} / 0x800 && setexpr write_size ${write_size} * 0x800
+check_bl2_size=test ${filesize} -le 0x100000
+check_fip_size=test ${filesize} -le 0x200000
+write_bl2=run check_bl2_size && run calc_write_size && mtd erase BL2 && mtd write BL2 ${loadaddr} 0 ${write_size}
+verify_bl2=mtd read BL2 ${verifyaddr} 0 ${write_size} && cmp.b ${loadaddr} ${verifyaddr} ${write_size}
+write_fip=run check_fip_size && run calc_write_size && mtd erase FIP && mtd write FIP ${loadaddr} 0 ${write_size}
+verify_fip=mtd read FIP ${verifyaddr} 0 ${write_size} && cmp.b ${loadaddr} ${verifyaddr} ${write_size}
+boot_slot0=ubi part ubi && ubi read ${loadaddr} kernel && bootm ${loadaddr}
