+++ b/arch/arm/dts/mt7987a-emplus-ehr330.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+#include "mt7987a.dtsi"
+
+/ {
+	model = "Emplus EHR330";
+	compatible = "emplus,ehr330", "mediatek,mt7987";
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x40000000>;
+	};
+};
--- /dev/null
+++ b/arch/arm/dts/mt7987a-emplus-ehr330-u-boot.dtsi
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "mt7987a-u-boot.dtsi"
+#include "mt7987-netsys-u-boot.dtsi"
+
+&eth0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio0_pins>;
+	phy-mode = "2500base-x";
+	phy-handle = <&phy2>;
+
+	phy2: ethernet-phy@2 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <2>;
+	};
+};
+
+&eth1 {
+	status = "okay";
+	phy-mode = "internal";
+	phy-handle = <&phy15>;
+
+	phy15: ethernet-phy@f {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <15>;
+	};
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_flash_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	must_tx;
+	enhance_timing;
+	dma_ext;
+	ipm_design;
+	support_quad;
+	tick_dly = <2>;
+	sample_sel = <0>;
+
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "BL2";
+				reg = <0x0 0x100000>;
+			};
+
+			partition@100000 {
+				label = "u-boot-env";
+				reg = <0x100000 0x80000>;
+			};
+
+			partition@180000 {
+				label = "Factory";
+				reg = <0x180000 0x400000>;
+			};
+
+			partition@580000 {
+				label = "FIP";
+				reg = <0x580000 0x200000>;
+			};
+
+			partition@780000 {
+				label = "ubi";
+				reg = <0x780000 0x6d00000>;
+				compatible = "linux,ubi";
+			};
+
+			partition@7480000 {
+				label = "ubi_1";
+				reg = <0x7480000 0x6d00000>;
+			};
+
+			partition@e180000 {
+				label = "cert";
+				reg = <0xe180000 0x60000>;
+			};
+
+			partition@e1e0000 {
+				label = "userconfig";
+				reg = <0xe1e0000 0xa0000>;
+			};
+
+			partition@e280000 {
+				label = "crashdump";
+				reg = <0xe280000 0x60000>;
+			};
+		};
+	};
+};
