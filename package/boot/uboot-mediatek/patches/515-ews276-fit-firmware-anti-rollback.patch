@@ -181,6 +181,21 @@
 	select OF_SYSTEM_SETUP
 	bool
 
+config MTK_ANTI_ROLLBACK
+	bool "Enforce MediaTek firmware anti-rollback versions"
+	depends on MT7986_EWS276_FIT_SECURE_BOOT
+	help
+	  Require signed fw_ar_ver metadata and compare it with the secure
+	  firmware's eFuse counter. Missing metadata or SMC failures fail boot.
+
+config MTK_AR_UPDATE_AR_VER
+	bool "Automatically advance firmware anti-rollback eFuses"
+	depends on MTK_ANTI_ROLLBACK
+	default n
+	help
+	  Irreversibly advance counters before booting a newer signed image.
+	  Leave disabled when counter updates are managed during provisioning.
+
 config MTK_EFUSE
 	bool
 	depends on TARGET_MT7986
