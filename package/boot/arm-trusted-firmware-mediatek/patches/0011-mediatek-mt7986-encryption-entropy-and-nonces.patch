Subject: [PATCH] mediatek: wire MT7986 encryption entropy and fresh FIP nonces

--- a/make_helpers/build_macros.mk
+++ b/make_helpers/build_macros.mk
@@ -153,7 +153,12 @@
 define ENCRYPT_FW
 $(2): $(1) enctool
 	$$(s)echo "  ENC     $$<"
+ifeq ($$(FIP_ENC),1)
+	@nonce="$$$$(openssl rand -hex 12)" && \
+		$$(ENCTOOL) $$(ENC_ARGS) -n "$$$$nonce" -i $$< -o $$@
+else
 	$$(q)$$(ENCTOOL) $$(ENC_ARGS) -i $$< -o $$@
+endif
 endef
 
 # TOOL_ADD_PAYLOAD appends the command line arguments required by fiptool to
--- a/plat/mediatek/mt7986/bl31/bl31.mk
+++ b/plat/mediatek/mt7986/bl31/bl31.mk
@@ -27,7 +27,7 @@
 				$(APSOC_COMMON)/bl31/plat_topology.c		\
 				$(APSOC_COMMON)/bl31/mtk_gic_v3.c		\
 				$(APSOC_COMMON)/bl31/plat_pm.c			\
-				$(APSOC_COMMON)/drivers/trng/v1/rng.c		\
+				$(APSOC_COMMON)/drivers/trng/v1/$(if $(filter 1,$(FW_ENC)),trng,rng).c \
 				$(MTK_PLAT_SOC)/aarch64/plat_helpers.S		\
 				$(MTK_PLAT_SOC)/aarch64/platform_common.c	\
 				$(MTK_PLAT_SOC)/bl31/bl31_plat_setup.c		\
@@ -43,6 +43,10 @@
 BL31_CPPFLAGS		+=	-DPLAT_XLAT_TABLES_DYNAMIC
 BL31_CPPFLAGS		+=	-I$(APSOC_COMMON)/bl31
 
+ifeq ($(FW_ENC),1)
+BL31_SOURCES		+=	$(MTK_PLAT)/drivers/rng/rng.c
+endif
+
 include $(APSOC_COMMON)/bl31/memdump.mk
 ifeq ($(EMERG_MEM_DUMP),1)
 BL31_SOURCES		+=	$(MTK_PLAT_SOC)/drivers/pll/pll.c		\
