From: OpenWrt EHR330 support <openwrt-devel@lists.openwrt.org>
Subject: [PATCH] tools: do not echo firmware encryption secrets

ENC_ARGS contains the firmware encryption key and nonce as hexadecimal
command-line arguments.  Never echo that invocation, even for verbose builds,
because build logs are commonly retained by CI systems.

---
 make_helpers/build_macros.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/make_helpers/build_macros.mk
+++ b/make_helpers/build_macros.mk
@@ -153,7 +153,7 @@ define ENCRYPT_FW
 $(2): $(1) enctool
 	$$(s)echo "  ENC     $$<"
-	$$(q)$$(ENCTOOL) $$(ENC_ARGS) -i $$< -o $$@
+	@$$(ENCTOOL) $$(ENC_ARGS) -i $$< -o $$@
 endef
 
 # TOOL_ADD_PAYLOAD appends the command line arguments required by fiptool to
