+static int w25n02lv_ooblayout_free(struct mtd_info *mtd, int section,
+				   struct mtd_oob_region *region)
+{
+	if (section > 3)
+		return -ERANGE;
+
+	/* Only User Data I is protected by the on-die ECC. */
+	region->offset = (16 * section) + 4;
+	region->length = 12;
+
+	return 0;
+}
