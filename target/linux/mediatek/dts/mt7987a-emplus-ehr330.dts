/dts-v1/;
#include "mt7987a.dtsi"

/ {
	model = "Emplus EHR330";
	compatible = "emplus,ehr330", "mediatek,mt7987a", "mediatek,mt7987";

	aliases {
		serial0 = &uart0;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf";
		rootdisk = <&ubi_rootdisk>;
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};
};

&eth {
	status = "okay";
};

&gmac0 {
	phy-handle = <&phy2>;
	phy-mode = "2500base-x";
	status = "okay";
};

&gmac1 {
	phy-handle = <&phy15>;
	phy-mode = "internal";
	status = "okay";
};

&mdio {
	phy2: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <2>;
	};

	phy15: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
		pinctrl-names = "i2p5gbe-led";
		pinctrl-0 = <&i2p5gbe_led0_pins>;
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";

		mt7996@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			device_type = "pci";
		};
	};
};

&pcie1 {
	status = "disabled";
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <128>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x0100000 0x0080000>;
			};

			factory: partition@180000 {
				label = "Factory";
				reg = <0x0180000 0x0400000>;
				read-only;
			};

			partition@580000 {
				label = "FIP";
				reg = <0x0580000 0x0200000>;
				read-only;
			};

			partition@780000 {
				label = "ubi";
				reg = <0x0780000 0x06d00000>;
				compatible = "linux,ubi";

				volumes {
					ubi_rootdisk: ubi-volume-kernel {
						volname = "kernel";
					};
				};
			};

			partition@7480000 {
				label = "ubi_1";
				reg = <0x07480000 0x06d00000>;
			};

			partition@e180000 {
				label = "cert";
				reg = <0x0e180000 0x0060000>;
				read-only;
			};

			partition@e1e0000 {
				label = "userconfig";
				reg = <0x0e1e0000 0x00a0000>;
			};

			partition@e280000 {
				label = "crashdump";
				reg = <0x0e280000 0x0060000>;
			};
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};